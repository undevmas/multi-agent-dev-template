# Tools/.env.example
#
# Copiar a Tools/.env y ajustar si algún puerto choca con algo que ya
# tengas corriendo localmente. Los defaults ya llevan un offset de
# +10000 sobre el puerto real de cada herramienta para minimizar choques.

# SonarQube — default real de la herramienta: 9000
SONARQUBE_HOST_PORT=19000

# Trivy server — default real de la herramienta: 4954
TRIVY_HOST_PORT=14954

# OWASP ZAP daemon — default real de la herramienta: 8080
ZAP_HOST_PORT=18080

# Token de SonarQube — generar una vez desde la UI (ver README.md,
# sección "Primer arranque de SonarQube"). Sin esto, sonar-scanner no corre.
SONAR_TOKEN=

# OWASP Dependency-Check — opcional. Sin esto, la primera corrida puede
# tardar 10-40 min descargando la base NVD sin autenticación (rate-limited
# por NIST). Con una API key gratuita (https://nvd.nist.gov/developers/request-an-api-key)
# baja a unos minutos. Corridas posteriores reusan el cache (volumen
# persistente) sin importar si se configuró o no.
DEPCHECK_NVD_API_KEY=

# Nombre de proyecto Docker Compose — aísla los contenedores/red/volúmenes
# de esta copia del template de los de cualquier otra copia (Compose usa
# por default el nombre de la carpeta "Tools", igual en todos los clones,
# lo que haría que dos proyectos distintos compartan el mismo SonarQube/
# Trivy/ZAP sin darse cuenta). setup-tools.ps1/.sh lo autocompletan con un
# valor único derivado del proyecto si se deja vacío — normalmente no hace
# falta tocar esto a mano.
COMPOSE_PROJECT_NAME=
