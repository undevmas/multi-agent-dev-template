# Tools/.env.example
#
# Copiar a Tools/.env y ajustar si algún puerto choca con algo que ya
# tengas corriendo localmente. Los defaults ya llevan un offset de
# +10000 sobre el puerto real de cada herramienta para minimizar choques.

# SonarQube — default real de la herramienta: 9000
SONARQUBE_HOST_PORT=19000

# Trivy server — default real de la herramienta: 4954
TRIVY_HOST_PORT=14954

# OWASP ZAP daemon — default real de la herramienta: 8080
ZAP_HOST_PORT=18080

# Token de SonarQube — generar una vez desde la UI (ver README.md,
# sección "Primer arranque de SonarQube"). Sin esto, sonar-scanner no corre.
SONAR_TOKEN=
